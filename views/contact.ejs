            <!-- CONTACT FORM -->
            <div class="col-lg-7">

                <div class="contact-form-card">

                    <h2>Send Me a Message</h2>

                    <p>
                        Fill out the form below to prepare an email.
                    </p>

                    <form action="mailto:Shahweez.mujtaba@ontariotechu.net"
                          method="post"
                          enctype="text/plain">

                        <div class="mb-4">
                            <label for="name" class="form-label">
                                Your Name
                            </label>

                            <input type="text"
                                   class="form-control"
                                   id="name"
                                   name="Name"
                                   placeholder="Enter your name"
                                   required>
                        </div>


                        <div class="mb-4">
                            <label for="email" class="form-label">
                                Your Email
                            </label>

                            <input type="email"
                                   class="form-control"
                                   id="email"
                                   name="Email"
                                   placeholder="Enter your email address"
                                   required>
                        </div>


                        <div class="mb-4">
                            <label for="subject" class="form-label">
                                Subject
                            </label>

                            <input type="text"
                                   class="form-control"
                                   id="subject"
                                   name="Subject"
                                   placeholder="Enter a subject"
                                   required>
                        </div>


                        <div class="mb-4">
                            <label for="message" class="form-label">
                                Message
                            </label>

                            <textarea class="form-control"
                                      id="message"
                                      name="Message"
                                      rows="6"
                                      placeholder="Write your message here..."
                                      required></textarea>
                        </div>


                        <button type="submit" class="btn btn-orange">
                            Prepare Email
                            <i class="fa-solid fa-paper-plane ms-2"></i>
                        </button>

                    </form>

                    <p class="form-note mt-3">
                        This form uses your device's default email
                        application. It does not send messages
                        directly through the website.
                    </p>

                </div>

            </div>

        </div>
